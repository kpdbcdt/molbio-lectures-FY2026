rules_version = '2';

// Firestore Security Rules for molbio-lectures-fy2026
//
// Polling system policy:
// - Reads: always allowed (students can review past results, public)
// - Writes: only during the scheduled lecture time window (server-time enforced)
// - Validation: poll documents must have a specific shape
// - Scope: polls_lec01 + polls_lec02 collections are writable during their windows
//
// Lec01 window: 2026-04-09 10:30 — 12:30 JST  (start 1775698200000 / end 1775705400000)
// Lec02 window: 2026-04-16 10:30 — 12:30 JST  (start 1776303000000 / end 1776310200000)

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Lec01 polls collection -----
    match /polls_lec01/{pollId} {
      allow read: if true;
      allow write: if request.time.toMillis() >= 1775698200000
                && request.time.toMillis() <= 1775705400000
                && pollId in ['q1', 'q2', 'q3', 'q4']
                && validPollWrite(request.resource.data);
    }

    // ----- Lec02 polls collection -----
    match /polls_lec02/{pollId} {
      allow read: if true;
      allow write: if request.time.toMillis() >= 1776303000000
                && request.time.toMillis() <= 1776310200000
                && pollId in ['q1', 'q2', 'q3', 'q4']
                && validPollWrite(request.resource.data);
    }

    // ----- Default deny everything else -----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Validate poll document structure on writes
function validPollWrite(data) {
  // Allow either:
  //   1) Initial creation: votes map with A,B,C,D as ints
  //   2) Increment update: at least one of votes.X / revealed / last_vote_at / reset_at
  //   3) Reset: votes={A:0,B:0,C:0,D:0}, revealed=false
  return ('votes' in data ? validVotes(data.votes) : true)
      && ('revealed' in data ? data.revealed is bool : true);
}

function validVotes(votes) {
  return votes is map
      && (!('A' in votes) || votes.A is int)
      && (!('B' in votes) || votes.B is int)
      && (!('C' in votes) || votes.C is int)
      && (!('D' in votes) || votes.D is int);
}
