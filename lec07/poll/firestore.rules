rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /polls_lec01/{pollId} {
      allow read: if true;
      allow write: if request.time.toMillis() >= 1775698200000
                && request.time.toMillis() <= 1775705400000
                && pollId in ['q1', 'q2', 'q3', 'q4']
                && validPollWrite(request.resource.data);
    }

    match /polls_lec02/{pollId} {
      allow read: if true;
      allow write: if request.time.toMillis() >= 1776303000000
                && request.time.toMillis() <= 1776310200000
                && pollId in ['q1', 'q2', 'q3']
                && validPollWrite(request.resource.data);
    }

    match /polls_lec03/{pollId} {
      allow read: if true;
      allow write: if request.time.toMillis() >= 1777512600000
                && request.time.toMillis() <= 1777519800000
                && pollId in ['q1', 'q2', 'q3']
                && validPollWrite(request.resource.data);
    }

    match /polls_lec04/{pollId} {
      allow read: if true;
      allow write: if request.time.toMillis() >= 1778117400000
                && request.time.toMillis() <= 1778124600000
                && pollId in ['q1', 'q2', 'q3']
                && validPollWrite(request.resource.data);
    }

    match /polls_lec05/{pollId} {
      allow read: if true;
      allow write: if request.time.toMillis() >= 1778722200000
                && request.time.toMillis() <= 1778729400000
                && pollId in ['q1', 'q2', 'q3']
                && validPollWrite(request.resource.data);
    }

    match /polls_lec06/{pollId} {
      allow read: if true;
      allow write: if request.time.toMillis() >= 1779327000000
                && request.time.toMillis() <= 1779334200000
                && pollId in ['q1', 'q2', 'q3']
                && validPollWrite(request.resource.data);
    }

    match /polls_lec07/{pollId} {
      allow read: if true;
      allow write: if request.time.toMillis() >= 1779931800000
                && request.time.toMillis() <= 1779939000000
                && pollId in ['q1', 'q2', 'q3']
                && validPollWrite(request.resource.data);
    }

    match /polls_lec08/{pollId} {
      allow read: if true;
      allow write: if request.time.toMillis() >= 1780536600000
                && request.time.toMillis() <= 1780543800000
                && pollId in ['q1', 'q2', 'q3']
                && validPollWrite(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function validPollWrite(data) {
  return ('votes' in data ? validVotes(data.votes) : true)
      && ('revealed' in data ? data.revealed is bool : true);
}

function validVotes(votes) {
  return votes is map
      && (!('A' in votes) || votes.A is int)
      && (!('B' in votes) || votes.B is int)
      && (!('C' in votes) || votes.C is int)
      && (!('D' in votes) || votes.D is int);
}
